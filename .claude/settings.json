{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(quarto render:*)",
      "Bash(python3 scripts/build.py:*)",
      "Bash(python3 scripts/new_book.py:*)"
    ]
  }
}
